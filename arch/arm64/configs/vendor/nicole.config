# DTBO
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Exfat
CONFIG_EXFAT_FS=y

# Platform
CONFIG_MACH_RAZER_NICOLE=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=m
CONFIG_TOUCHSCREEN_GOODIX_BRL=m
CONFIG_TOUCHSCREEN_GOODIX_BRL_SPI=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_GESTURE=y
CONFIG_TOUCHSCREEN_GOODIX_BRL_FW_UPDATE=y

# Vibrator
CONFIG_HAPTIC_NV=y

# Wifi
CONFIG_QCA_CLD_WLAN=m
