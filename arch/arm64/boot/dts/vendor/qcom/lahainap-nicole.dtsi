&usb1 {
	status = "disabled";
};

&usb2_phy1 {
	status = "disabled";
};

&usb_qmp_phy {
	status = "disabled";
};

&pmk8350_adc_tm {
	io-channels = <&pmk8350_vadc PM8350_ADC7_AMUX_THM1_100K_PU>,
			<&pmk8350_vadc PM8350_ADC7_AMUX_THM2_100K_PU>,
			<&pmk8350_vadc PM8350B_ADC7_AMUX_THM3_100K_PU>,
			<&pmk8350_vadc PM8350_ADC7_AMUX_THM4_100K_PU>,
			<&pmk8350_vadc PM8350_ADC7_AMUX_THM5_100K_PU>,
			<&pmk8350_vadc PM8350B_ADC7_AMUX_THM4_100K_PU>,
			<&pmk8350_vadc PM8350B_ADC7_GPIO2_100K_PU>,
			<&pmk8350_vadc PMK8350_ADC7_AMUX_THM1_100K_PU>;

	/delete-node/ pm8350_hot_pocket_therm;

	pm8350_smb_temp_therm {
		reg = <PM8350B_ADC7_AMUX_THM3_100K_PU>;
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
	};
};

&pmk8350_vadc {
	pm8350b_smb_temp_therm {
		reg = <PM8350B_ADC7_AMUX_THM3_100K_PU>;
		label = "pm8350b_smb_temp_therm";
		qcom,ratiometric;
		qcom,hw-settle-time = <200>;
		qcom,pre-scaling = <1 1>;
	};
};

&thermal_zones {
	cpu-1-6-step {
		trips {
			fan_cpu16_config0: fan-cpu16-config0 {
				temperature = <80000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu16_config1: fan-cpu16-config1 {
				temperature = <90000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu16_config2: fan-cpu16-config2 {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_cpu16_config0>;
				cooling-device = <&fancontroller 5 5>;
			};

			fan_cdev_1 {
				trip = <&fan_cpu16_config1>;
				cooling-device = <&fancontroller 6 6>;
			};

			fan_cdev_2 {
				trip = <&fan_cpu16_config2>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	cpu-1-7-step {
		trips {
			fan_cpu17_config0: fan-cpu17-config0 {
				temperature = <80000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu17_config1: fan-cpu17-config1 {
				temperature = <90000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_cpu17_config2: fan-cpu17-config2 {
				temperature = <95000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_cpu17_config0>;
				cooling-device = <&fancontroller 5 5>;
			};

			fan_cdev_1 {
				trip = <&fan_cpu17_config1>;
				cooling-device = <&fancontroller 6 6>;
			};

			fan_cdev_2 {
				trip = <&fan_cpu17_config2>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	gpuss-0-step {
		trips {
			fan_gpuss0_config0: fan-gpuss0-config0 {
				temperature = <85000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_gpuss0_config1: fan-gpuss0-config1 {
				temperature = <90000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_gpuss0_config2: fan-gpuss0-config2 {
				temperature = <95000>;
				hysteresis = <0>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_gpuss0_config0>;
				cooling-device = <&fancontroller 5 5>;
			};

			fan_cdev_1 {
				trip = <&fan_gpuss0_config1>;
				cooling-device = <&fancontroller 6 6>;
			};

			fan_cdev_2 {
				trip = <&fan_gpuss0_config2>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	gpuss-1-step {
		trips {
			fan_gpuss1_config0: fan-gpuss1-config0 {
				temperature = <85000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_gpuss1_config1: fan-gpuss1-config1 {
				temperature = <90000>;
				hysteresis = <5000>;
				type = "passive";
			};

			fan_gpuss1_config2: fan-gpuss1-config2 {
				temperature = <95000>;
				hysteresis = <0>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_gpuss1_config0>;
				cooling-device = <&fancontroller 5 5>;
			};

			fan_cdev_1 {
				trip = <&fan_gpuss1_config1>;
				cooling-device = <&fancontroller 6 6>;
			};

			fan_cdev_2 {
				trip = <&fan_gpuss1_config2>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	video-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&tsens1 6>;
		trips {
			fan_video_config0: fan-video-config0 {
				temperature = <90000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_cdev_0 {
				trip = <&fan_video_config0>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	gpu-skin-avg-step {
		disable-thermal-zone;
	};

	smb-temp-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pmk8350_adc_tm PM8350B_ADC7_AMUX_THM3_100K_PU>;
		wake-capable-sensor;
		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	camera-therm-usr {
		disable-thermal-zone;
	};

	rear-cam-therm-usr {
		disable-thermal-zone;
	};

	socd {
		disable-thermal-zone;
	};

	hot-pock-therm-usr {
		disable-thermal-zone;
	};

	tof-therm-usr {
		disable-thermal-zone;
	};

	quiet-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pmk8350_adc_tm PM8350_ADC7_AMUX_THM2_100K_PU>;
		trips {
			fan_quiet_config0: fan-quiet-config0 {
				temperature = <32000>;
				hysteresis = <2000>;
				type = "passive";
			};

			fan_quiet_config1: fan-quiet-config1 {
				temperature = <34000>;
				hysteresis = <2000>;
				type = "passive";
			};

			fan_quiet_config2: fan-quiet-config2 {
				temperature = <36000>;
				hysteresis = <2000>;
				type = "passive";
			};

			fan_quiet_config3: fan-quiet-config3 {
				temperature = <38000>;
				hysteresis = <2000>;
				type = "passive";
			};

			fan_quiet_config4: fan-quiet-config4 {
				temperature = <40000>;
				hysteresis = <2000>;
				type = "passive";
			};

			fan_quiet_config5: fan-quiet-config5 {
				temperature = <42000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			fan_quiet_cdev_0 {
				trip = <&fan_quiet_config0>;
				cooling-device = <&fancontroller 2 2>;
			};

			fan_quiet_cdev_1 {
				trip = <&fan_quiet_config1>;
				cooling-device = <&fancontroller 3 3>;
			};

			fan_quiet_cdev_2 {
				trip = <&fan_quiet_config2>;
				cooling-device = <&fancontroller 4 4>;
			};

			fan_quiet_cdev_3 {
				trip = <&fan_quiet_config3>;
				cooling-device = <&fancontroller 5 5>;
			};

			fan_quiet_cdev_4 {
				trip = <&fan_quiet_config4>;
				cooling-device = <&fancontroller 6 6>;
			};

			fan_quiet_cdev_5 {
				trip = <&fan_quiet_config5>;
				cooling-device = <&fancontroller 7 7>;
			};
		};
	};

	quiet-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pmk8350_adc_tm PM8350_ADC7_AMUX_THM2_100K_PU>;
		wake-capable-sensor;
		trips {
			active-config0 {
				temperature = <38000>;
				hysteresis = <2000>;
				type = "passive";
			};

			active-config1 {
				temperature = <40000>;
				hysteresis = <2000>;
				type = "passive";
			};

			active-config2 {
				temperature = <42000>;
				hysteresis = <2000>;
				type = "passive";
			};

			active-config3 {
				temperature = <44000>;
				hysteresis = <2000>;
				type = "passive";
			};

			active-config4 {
				temperature = <46000>;
				hysteresis = <2000>;
				type = "passive";
			};
		};
	};

	qtm-w-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pmk8350_adc_tm PM8350_ADC7_AMUX_THM4_100K_PU>;
		wake-capable-sensor;
		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	qtm-n-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pmk8350_adc_tm PM8350_ADC7_AMUX_THM5_100K_PU>;
