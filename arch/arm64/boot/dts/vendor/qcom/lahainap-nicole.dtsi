		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};

&pcie1 {
	qcom,link-check-max-count = <50>;
	qcom,boot-option = <0x0>;
};
